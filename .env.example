# ==============================================================================
# STYLECRAFT LENS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Anthropic Claude API Key (PRIMARY provider for competitive analysis and
# GTM/TDS/Content Form generation — includes built-in web search, so no
# separate search key is needed. OpenAI below is used as a fallback whenever
# this is unset or a call fails.)
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# Only required if your key is an ORG-level key not scoped to one workspace
# (confirmed live: such a key gets a 400 "not scoped to a workspace" error
# without this). Find it in the Console's workspace settings/URL. Leave
# unset if your key already comes from a specific workspace.
ANTHROPIC_WORKSPACE_ID=""

# Google Gemini API Key (artwork vision analysis, and a last-resort fallback
# behind Claude/OpenAI for analysis/GTM generation — currently disabled
# app-wide via a kill-switch in lib/gemini.ts pending a valid key)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key"

# Rainforest API Key (for real-time Amazon pricing, ratings, reviews & BSR lookup)
# Sign up / get key at: https://trajectdata.com/discover-rainforest-api/
RAINFOREST_API_KEY="your_rainforest_api_key"

# OpenAI API Key (FALLBACK provider — used automatically whenever Claude is
# unavailable or fails, for analysis/synthesis, web search/scraping, and
# review analysis. Get a key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-..."

# Database / PostgreSQL Connection String (Optional - falls back to memoryDb if unconfigured)
DATABASE_URL="postgresql://user:password@localhost:5432/stylecraft_lens"

# Supabase Storage & Database Configuration (Optional - falls back to memoryDb if unconfigured)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Clerk Authentication Keys (Optional - mock auth enabled if unconfigured)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Google Drive Integration (Optional - "Save to Drive" falls back to a mock
# link if unconfigured). All three are required together:
# 1. GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET: from Google Cloud Console ->
#    APIs & Services -> Credentials -> OAuth 2.0 Client IDs (type: Web application)
# 2. GOOGLE_REFRESH_TOKEN: generated once via https://developers.google.com/oauthplayground
#    using the Client ID/Secret above and the Drive API scope
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REFRESH_TOKEN="your_google_refresh_token"

# Contact Support email delivery (Optional — submissions still save to the
# database without this; only the email notification is skipped, flagged
# email_status='failed' for admins at Settings -> Support Messages).
# Get a key at: https://resend.com/api-keys — the sender domain (default
# stylecraftus.com below) must be verified in Resend (SPF/DKIM) or mail
# will land in spam / fail to send.
RESEND_API_KEY="re_..."
# Inbox that receives every Contact Support submission.
SUPPORT_INBOX_EMAIL="jashwanthd@stylecraftus.com"
# Verified sender address/name Resend sends FROM (Reply-To is always the
# submitter's own email, so replying in your mail client goes straight to them).
SUPPORT_FROM_EMAIL="Lens Support <lens-support@stylecraftus.com>"
